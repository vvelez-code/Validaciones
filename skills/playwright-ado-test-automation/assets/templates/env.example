# Copia este archivo como `env` (ambiente test) o `env.<nombre>` (otro ambiente) y completa
# los valores. `env` y `env.*` están en .gitignore: NUNCA los subas ni pegues sus valores en
# código, documentación o reportes.
#
#   TEST_ENV=<nombre> npx playwright test      |   python qa-validate.py --env <nombre>
#
# ── Variante API ─────────────────────────────────────────────
API_BASE_URL=https://api.example.com/api/v1
SWAGGER_URL=https://api.example.com/swagger/index.html
AUTH_LOGIN_URL=https://auth.example.com/api/v1/auth/login
AUTH_EMAIL=<usuario-de-prueba>
AUTH_PASSWORD=<contraseña>

# ── Variante UI ──────────────────────────────────────────────
FRONT_LOGIN_URL=https://app.example.com/login
FRONT_SCREEN_URL=https://app.example.com/<pantalla>
FRONT_EMAIL=<usuario-del-front>
FRONT_PASSWORD=<contraseña>

# ── Datos de prueba reutilizables (opcionales; si faltan, los tests se saltan) ──
FIXTURE_IDS=<id1>,<id2>,<id3>

# ── General ──────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=45000

# ── Evidencia y datos sensibles ──────────────────────────────
# Evidencia VISUAL (capturas, video, traza): puede mostrar tokens o datos personales.
#   on-failure (por defecto) → se conserva solo cuando el test falla
#   always                   → siempre (cuando se pide evidencia visual de toda ejecución)
#   off                      → nunca
# Los JSON de request/response/resultado se guardan siempre, con las claves sensibles en "***".
EVIDENCE_CAPTURE=on-failure
# Claves extra a censurar en los JSON (además de password, token, authorization, apiKey...)
EVIDENCE_REDACT_KEYS=
# PW_VIDEO=off   # apaga el video aunque EVIDENCE_CAPTURE=always (útil en la variante API)

# ── Azure DevOps (solo para qa-validate.py / ado_fetch_cases.py) ──
# PAT con permisos Test Management (Read & Write) y Work Items (Read).
# Si un env.<nombre> no lo trae, qa-validate.py lo toma de `env`.
ADO_PAT=<personal-access-token>
